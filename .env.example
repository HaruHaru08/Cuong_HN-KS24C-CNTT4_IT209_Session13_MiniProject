# ==========================================
# Campus Hub Pro - Environment Configuration
# Copy this file to .env before deploying
# ==========================================

# Database Configurations
DB_NAME=campus_hub
DB_USERNAME=campushub
DB_PASSWORD=campushub_secure_password_here
MYSQL_ROOT_PASSWORD=mysql_root_secure_password_here
DB_PORT=3307

# Frontend Port Configuration
FRONTEND_PORT=80

# Backend Port Configuration
SERVER_PORT=8080

# Cross-Origin Resource Sharing
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
